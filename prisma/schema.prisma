generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model user {
  id       String  @id @default(uuid())
  username String
  password String  @unique
  email    String  @unique
  posts    Blogs[]
}

model Blogs {
  id        String  @id @default(uuid())
  title     String
  content   String
  published Boolean @default(false)
  author    user    @relation(fields: [authorId], references: [id])
  authorId  String
}

